{{/* theme: builtin */}}
{{ define "content" }}
<div class="page-file-editor">
    {{ if .Data.FilePath }}
		{{ if .Data.SectionID }}
			<h2>
				{{ T "Edit Section" }}: {{ .Data.SectionID }} {{ T "in" }}
				<a href="/files/{{ .Data.FilePath }}">{{ .Data.FilePath }}</a>
			</h2>
		{{ else }}
			<h2>
				{{ T "Edit" }}:
				<a href="/files/{{ .Data.FilePath }}">{{ .Data.FilePath }}</a>
			</h2>
		{{ end }}


		<div class="editor-wrap"
			hx-get="/api/editor?filepath={{ .Data.FilePath }}{{ if .Data.SectionID }}&section={{ .Data.SectionID }}{{ end }}"
			hx-trigger="load"
			hx-target="this"
			hx-swap="outerHTML"
		>
			loading editor...
		</div>
	{{ else }}
		<div class="error">
			<h1>{{ T "Error" }}</h1>
			<p>{{ T "File path not provided" }}</p>
		</div>
	{{ end }}
</div>
{{ end }}
