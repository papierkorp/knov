{{/* theme: builtin */}}
{{ define "content" }}
<div class="page-admin">
    <h1>{{T "Admin"}}</h1>
    <div class="admin-links">
        <a href="/swagger/" target="_blank" rel="noopener noreferrer">{{T "Swagger"}}</a>
        <a href="/system/changelog">{{T "Changelog"}}</a>
        <a href="/system/logs">{{T "Logs"}}</a>
        <a href="/system/jobs">{{T "Jobs"}}</a>
        <a href="/system/backup">{{T "Backups"}}</a>
        <a href="/system/environment">{{T "Environment"}}</a>
        <a href="/system/version" onclick="closePanel()">{{T "Version"}}</a>
    </div>
    <div class="settings-sections">

        <div class="settings-col">
            <section class="settings-section">
                <h2>{{T "System Actions"}}</h2>
                <div class="setting-item">
                    <div class="help-text">{{T "system maintenance operations for keeping your application running smoothly"}}</div>
                    <div class="admin-action-list">
                        <button class="btn-secondary" hx-post="/api/metadata/rebuild"
                                hx-target="#rebuild-metadata-status" hx-swap="innerHTML"
                                hx-confirm="{{T "Rebuild all metadata? This may take a while."}}">
                            {{T "Rebuild Metadata"}}
                        </button>
                        <span id="rebuild-metadata-status"></span>
                        <button class="btn-secondary" hx-post="/api/cronjob" hx-swap="none">
                            {{T "Run Cronjob"}}
                        </button>
                        <button class="btn-secondary" hx-delete="/api/system/cache" hx-swap="none"
                                hx-confirm="{{T "Invalidate the cache? It will be rebuilt automatically."}}">
                            {{T "Invalidate Cache"}}
                        </button>
                        <button class="btn-danger" hx-post="/api/system/restart" hx-swap="none"
                                hx-confirm="{{T "Restart the system? This will disconnect all users."}}">
                            {{T "Restart System"}}
                        </button>
                    </div>
                </div>
            </section>

            {{if .Data.AppConfig.GitRemote}}
            <section class="settings-section">
                <h2>{{T "Git Remote Sync"}}</h2>
                <div class="setting-item">
                    <div class="help-text">{{T "remote"}}: <code>{{.Data.AppConfig.GitRemote}}</code> / <code>{{.Data.AppConfig.GitRemoteBranch}}</code></div>
                    <div class="admin-action-list">
                        <button class="btn-secondary" hx-post="/api/git/pull" hx-swap="none">
                            <i class="fa fa-arrow-down"></i> {{T "Pull"}}
                        </button>
                        <button class="btn-secondary" hx-post="/api/git/push" hx-swap="none">
                            <i class="fa fa-arrow-up"></i> {{T "Push"}}
                        </button>
                        <button class="btn-secondary" hx-post="/api/git/test-auth" hx-swap="innerHTML" hx-target="#git-test-result">
                            <i class="fa fa-plug"></i> {{T "Test Auth"}} (debug)
                        </button>
                    </div>
                    <div id="git-test-result" style="margin-top:8px;font-size:0.85em;"></div>
                </div>
            </section>
            {{end}}

            <section class="settings-section">
                <h2>{{T "Storage Statistics"}}</h2>
                <div class="setting-item">
                    <div class="help-text">{{T "media file storage usage and cleanup"}}</div>
                    <div hx-get="/api/media/stats" hx-trigger="load" hx-target="this" hx-swap="innerHTML">
                        {{T "loading..."}}
                    </div>
                    <div style="margin-top:12px;">
                        <button class="btn-danger" hx-post="/api/media/cleanup-orphaned" hx-swap="none"
                                hx-confirm="{{T "Delete all orphaned media files? This cannot be undone."}}">
                            <i class="fa fa-trash"></i> {{T "Cleanup Orphaned Files"}}
                        </button>
                    </div>
                </div>
            </section>
            <section class="settings-section">
                <h2>{{T "Export / Import"}}</h2>
                <div class="setting-item">
                    <div class="help-text">{{T "export settings or data for backup and migration, or import a previously exported settings file"}}</div>
                    <div style="display:flex;flex-direction:column;gap:12px;margin-top:8px;">
                        <div>
                            <strong>{{T "Settings"}}</strong>
                            <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px;">
                                <a href="/api/config/export" download="knov-settings.json" class="btn-secondary">
                                    <i class="fa fa-download"></i> {{T "export settings"}}
                                </a>
                                <form hx-post="/api/config/import" hx-encoding="multipart/form-data" hx-swap="none" style="display:flex;">
                                    <label for="import-settings-file" class="btn-secondary" style="cursor:pointer;margin:0;">
                                        <i class="fa fa-upload"></i> {{T "import settings"}}
                                    </label>
                                    <input type="file" id="import-settings-file" name="file" accept=".json" required
                                           style="display:none;" onchange="this.closest('form').requestSubmit()"/>
                                </form>
                            </div>
                        </div>
                        <div>
                            <strong>{{T "Metadata"}}</strong>
                            <form action="/api/metadata/export" method="post" style="display:flex;gap:6px;align-items:center;margin-top:6px;">
                                <select name="format" id="export-format" class="form-select" style="width:auto;">
                                    <option value="json">JSON</option>
                                    <option value="csv">CSV</option>
                                </select>
                                <button type="submit" class="btn-secondary">
                                    <i class="fa fa-download"></i> {{T "export metadata"}}
                                </button>
                            </form>
                        </div>
                        <div>
                            <strong>{{T "Files"}}</strong>
                            <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px;">
                                <form action="/api/files/export/zip" method="post">
                                    <button type="submit" class="btn-secondary"><i class="fa fa-download"></i> {{T "export all files"}}</button>
                                </form>
                                <form action="/api/files/export/markdown-converted" method="post">
                                    <button type="submit" class="btn-secondary"><i class="fa fa-download"></i> {{T "export all files (DokuWiki to Markdown)"}}</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="settings-col">
            {{ template "version-section" . }}
            {{ template "environment-section" . }}
        </div>

        <section class="settings-section settings-section-wide">
            <h2>{{T "Bulk Metadata Update"}}</h2>
            <div class="setting-item">
                <div class="help-text">{{T "apply a metadata change to all files matching a filter"}}</div>
                <form id="bulk-update-form">
                <div class="bulk-update-grid">
                    <div>
                        <div class="bulk-update-group-label">{{T "Filter"}}</div>
                        <label>
                            {{T "Field"}}
                            <select id="bulk-filter-field" name="filterField" class="form-select" onchange="bulkFilterFieldChanged()">
                                <option value="editor">{{T "editor"}}</option>
                                <option value="tags">{{T "tags"}}</option>
                                <option value="collection">{{T "collection"}}</option>
                                <option value="title">{{T "title"}}</option>
                                <option value="folders">{{T "folders"}}</option>
                            </select>
                        </label>
                        <label>
                            {{T "Operator"}}
                            <select id="bulk-filter-op" name="filterOp" class="form-select">
                                <option value="equals">{{T "equals"}}</option>
                                <option value="contains">{{T "contains"}}</option>
                                <option value="regex">{{T "regex"}}</option>
                            </select>
                        </label>
                        <label>
                            {{T "Value"}}
                            <div id="bulk-filter-value-wrap">
                                <select id="bulk-filter-value-select" name="filterValue" class="form-select"
                                        hx-get="/api/metadata/editors?format=options" hx-trigger="load" hx-target="this" hx-swap="innerHTML"></select>
                            </div>
                        </label>
                    </div>
                    <div>
                        <div class="bulk-update-group-label">{{T "Update"}}</div>
                        <label>
                            {{T "Action"}}
                            <select id="bulk-action" name="action" class="form-select" onchange="bulkActionChanged()">
                                <option value="set-editor">{{T "set editor"}}</option>
                                <option value="add-tag">{{T "add tag"}}</option>
                                <option value="remove-tag">{{T "remove tag"}}</option>
                            </select>
                        </label>
                        <label>
                            {{T "Value"}}
                            <div id="bulk-patch-value-wrap">
                                <select id="bulk-patch-value-select" name="patchValue" class="form-select"
                                        hx-get="/api/metadata/editors?format=options" hx-trigger="load" hx-target="this" hx-swap="innerHTML"></select>
                            </div>
                        </label>
                    </div>
                </div>
                <div class="bulk-update-actions">
                    <button type="button" class="btn-secondary"
                            hx-post="/api/metadata/bulk-update" hx-vals='{"preview":"true"}'
                            hx-include="#bulk-update-form" hx-target="#bulk-update-result" hx-swap="innerHTML">{{T "Preview"}}</button>
                    <button type="button" class="btn-danger"
                            hx-post="/api/metadata/bulk-update" hx-vals='{"preview":"false"}'
                            hx-include="#bulk-update-form" hx-target="#bulk-update-result" hx-swap="innerHTML"
                            hx-confirm="{{T "Apply bulk metadata change? This cannot be undone."}}">{{T "Apply"}}</button>
                </div>
                </form>
                <div id="bulk-update-result"></div>
                <script>
                function bulkFilterFieldChanged() {
                    const field = document.getElementById('bulk-filter-field').value;
                    const wrap = document.getElementById('bulk-filter-value-wrap');
                    if (field === 'editor') {
                        wrap.innerHTML = '<select id="bulk-filter-value-select" name="filterValue" class="form-select" hx-get="/api/metadata/editors?format=options" hx-trigger="load" hx-target="this" hx-swap="innerHTML"></select>';
                        htmx.process(wrap);
                    } else {
                        wrap.innerHTML = '<input id="bulk-filter-value-select" name="filterValue" type="text" class="form-input" />';
                    }
                }
                function bulkActionChanged() {
                    const action = document.getElementById('bulk-action').value;
                    const wrap = document.getElementById('bulk-patch-value-wrap');
                    if (action === 'set-editor') {
                        wrap.innerHTML = '<select id="bulk-patch-value-select" name="patchValue" class="form-select" hx-get="/api/metadata/editors?format=options" hx-trigger="load" hx-target="this" hx-swap="innerHTML"></select>';
                        htmx.process(wrap);
                    } else {
                        wrap.innerHTML = '<input id="bulk-patch-value-select" name="patchValue" type="text" class="form-input" placeholder="{{T "tag name"}}" />';
                    }
                }
                </script>
            </div>
        </section>

        <section class="settings-section settings-section-wide">
            <h2>{{T "Repair Broken Links"}}</h2>
            <div class="setting-item">
                <div class="help-text">{{T "scan all files for links pointing to paths that no longer exist and repair the selected ones"}}</div>
                <button type="button" class="btn-secondary"
                        hx-get="/api/metadata/broken-links"
                        hx-target="#broken-links-result" hx-swap="innerHTML">{{T "Scan for Broken Links"}}</button>
                <div id="broken-links-result" style="margin-top:12px;"></div>
                <script>
                function toggleAllBrokenLinks(checkbox) {
                    document.querySelectorAll('#component-broken-links input[name="repair"]').forEach(cb => cb.checked = checkbox.checked);
                }
                </script>
            </div>
        </section>

        <section class="settings-section settings-section-wide">
            <h2>{{T "Test Data"}}</h2>
            <div class="setting-item">
                <div class="help-text">{{T "manage test data for development and testing purposes"}}</div>
                <div class="admin-action-list">
                    <button class="btn-secondary" hx-post="/api/testdata/setup" hx-swap="none"
                            hx-confirm="{{T "Setup test data? This will create example files in the data/test folder."}}">
                        {{T "Setup Test Data"}}
                    </button>
                    <button class="btn-danger" hx-post="/api/testdata/clean" hx-swap="none"
                            hx-confirm="{{T "This will remove all files in the data/test Folder."}}">
                        {{T "Clean Test Data"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/run-all" hx-target="#testdata-result"
                            hx-confirm="{{T "Run all test suites? This will create test metadata objects."}}">
                        {{T "Run All Tests"}}
                    </button>
                    <button class="btn-secondary" hx-get="/api/testdata/filtertest/testdata" hx-target="#testdata-result">
                        {{T "View Filter Test Metadata"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/filtertest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run filter tests? This will create test metadata objects."}}">
                        {{T "Run Filter Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/editorstest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run editors tests? This will create test files and metadata."}}">
                        {{T "Run Editors Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/searchtest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run search tests? This will create test files and git commits."}}">
                        {{T "Run Search Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/githistorytest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run git history tests? This will create test files, git commits, and temporarily point the git remote at a throwaway local repo."}}">
                        {{T "Run Git History Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/chattest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run chat tests? This will create and delete chat messages and test files."}}">
                        {{T "Run Chat Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/dashboardtest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run dashboard tests? This will create and delete test dashboards."}}">
                        {{T "Run Dashboard Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/kanbantest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run kanban tests? This will create test files and move kanban cards."}}">
                        {{T "Run Kanban Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/browsetest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run browse tests? This will create test files and folders."}}">
                        {{T "Run Browse Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/metadatatest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run metadata tests? This will create and delete test metadata and references."}}">
                        {{T "Run Metadata Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/connectionstest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run connections tests? This will create test files with parent/child/link relationships."}}">
                        {{T "Run Connections Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/jobstest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run jobs tests? This will trigger a full metadata rebuild, search reindex, cache invalidate and media cleanup."}}">
                        {{T "Run Jobs Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/asyncjobtest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run async job tests? This will start/interrupt-recover real background jobs and consume pending notifications."}}">
                        {{T "Run Async Job Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/mediatest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run media tests? This will upload, rename and delete test media files."}}">
                        {{T "Run Media Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/exporttest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run export tests? This will export test files as zip and round-trip a settings export."}}">
                        {{T "Run Export Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/notificationtest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run notification tests? This will add, consume and clear real notifications."}}">
                        {{T "Run Notification Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/settingstest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run settings tests? This will temporarily change real settings, theme and favicon, then restore them."}}">
                        {{T "Run Settings Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/logstest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run logs tests? This will write probe entries to the in-app-tests log."}}">
                        {{T "Run Logs Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/parsertest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run parser tests?"}}">
                        {{T "Run Parser Tests"}}
                    </button>
                    <button class="btn-secondary" hx-post="/api/testdata/backuptest" hx-target="#testdata-result"
                            hx-confirm="{{T "Run backup tests? This will create real backups of live storages into scratch targets, and briefly restore them in place."}}">
                        {{T "Run Backup Tests"}}
                    </button>
                </div>
            </div>
            <div id="testdata-result"></div>
        </section>

    </div>
</div>
{{ end }}


{{ define "version-section" }}
<section class="settings-section">
    <h2>{{T "Version"}}</h2>
    <div class="setting-item">
        <div hx-get="/api/system/version" hx-trigger="load" hx-target="this" hx-swap="innerHTML">{{T "loading..."}}</div>
    </div>
</section>
{{ end }}

{{ define "environment-section" }}
<section class="settings-section">
    <h2>{{T "Environment"}}</h2>
    <div class="setting-item">
        <div hx-get="/api/system/environment?view=summary" hx-trigger="load" hx-target="this" hx-swap="innerHTML">{{T "loading..."}}</div>
    </div>
</section>
{{ end }}
