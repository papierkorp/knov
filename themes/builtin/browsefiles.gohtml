{{/* theme: builtin */}}
{{ define "content" }}
<div class="page-browse-files">
    <div class="browse-header">
        <h1>{{if .Data.MetadataType}}{{T "Files with"}} {{ .Data.MetadataType }}: <span class="filter-value">{{ .Data.Value }}</span>{{else}}{{T "All Files"}}{{end}}</h1>
        <div class="browse-breadcrumb">
            <a href="/">{{T "Home"}}</a>
            → <a href="/browse">{{T "Browse"}}</a>
            → <span>{{if .Data.MetadataType}}{{ .Data.MetadataType }}: {{ .Data.Value }}{{else}}{{T "All Files"}}{{end}}</span>
        </div>
        {{if or (eq .Data.MetadataType "collection") (eq .Data.MetadataType "folder") (eq .Data.MetadataType "tag")}}
        <button class="btn-danger btn-small"
                hx-delete="/api/files/bulk?type={{ .Data.MetadataType }}&value={{ urlQuery .Data.Value }}"
                hx-confirm='{{T "delete all files in this"}} {{ .Data.MetadataType }}?'
                hx-target="this"
                hx-swap="outerHTML">
            <i class="fa fa-trash"></i> {{T "delete all files"}}
        </button>
        {{end}}
    </div>
    <div class="browse-content">
        <div
            hx-get="{{if .Data.MetadataType}}/api/files/browse?metadata={{ .Data.MetadataType }}&value={{ urlQuery .Data.Value }}{{else}}/api/files/list{{end}}&actions=true"
            hx-trigger="load"
            hx-headers='{"Accept": "text/html"}'
            class="filter-results"
        >
            {{T "Loading files..."}}
        </div>
    </div>
</div>
{{ end }}
