# generated by `make env-example` (see tools/genenv) from internal/configmanager/envdefs.go
# do not edit by hand - your changes will be overwritten

# ── paths ─────────────────────────────────────────────────────────────────
# path to the markdown data folder (relative to the executable)
KNOV_DATA_PATH=data
# path to the themes folder (relative to the executable)
KNOV_THEMES_PATH=themes
# path to the app's internal storage (metadata/cache/search/kanban databases; relative to the executable)
KNOV_STORAGE_PATH=storage
# path to the log files (relative to the executable)
KNOV_LOGS_PATH=logs
# path backup sets are written to and restored from (relative to the executable)
KNOV_BACKUPS_PATH=backups

# ── server ────────────────────────────────────────────────────────────────
# port the app listens on
KNOV_SERVER_PORT=1324
# interface the app listens on; empty = all interfaces, use 127.0.0.1 to only
# allow local access
KNOV_SERVER_HOST=
# message shown in a banner at the top of every page (e.g. to label a test/copy
# environment); empty = hidden
KNOV_MOTD=

# ── logging ───────────────────────────────────────────────────────────────
# stdout log level
# options: debug, info, warning, error
KNOV_LOG_LEVEL=info
# file logging (writes to logs/app.log with rotation)
# options: true, false
KNOV_LOG_FILE_ENABLED=true
# file log level
# options: debug, info, warning, error
KNOV_LOG_FILE_LEVEL=info
# max size in MB before rotating
KNOV_LOG_MAX_SIZE_MB=10
# number of rotated files to keep
KNOV_LOG_MAX_FILES=5

# ── git ───────────────────────────────────────────────────────────────────
# remote sync URL (leave empty for local-only mode); if set and no local
# repo exists yet, knov will clone it on first start
KNOV_GIT_REMOTE=
# remote branch to sync with
KNOV_GIT_REMOTE_BRANCH=main
# automatically push after every commit
# options: true, false
KNOV_GIT_AUTO_PUSH=true
# timeout for push/pull operations
KNOV_GIT_PUSH_TIMEOUT=10s
# HTTPS username (leave empty for SSH or local repo)
KNOV_GIT_USER=
# HTTPS password (leave empty for SSH or local repo)
KNOV_GIT_PASSWORD=
# HTTPS access token, takes priority over KNOV_GIT_PASSWORD (leave empty for SSH or local repo)
KNOV_GIT_TOKEN=
# SSH private key path (leave empty to use ssh-agent or ~/.ssh/id_rsa, id_ed25519, id_ecdsa);
# set this if you use a non-default key file, e.g. ~/.ssh/id_rsa_privat
KNOV_GIT_SSH_KEY=

# ── storage providers ─────────────────────────────────────────────────────
# app settings storage
# options: json
KNOV_CONFIG_STORAGE_PROVIDER=json
# metadata storage
# options: json, yaml, sqlite
KNOV_METADATA_STORAGE_PROVIDER=sqlite
# cache storage
# options: json, sqlite
KNOV_CACHE_STORAGE_PROVIDER=sqlite
# search index storage
# options: sqlite
KNOV_SEARCH_STORAGE_PROVIDER=sqlite
# kanban event log storage
# options: json, sqlite
KNOV_KANBAN_EVENTS_STORAGE_PROVIDER=sqlite

# ── search ────────────────────────────────────────────────────────────────
# search engine
# options: repository, grep
KNOV_SEARCH_ENGINE=repository

# ── cronjob ───────────────────────────────────────────────────────────────
# how often the background cronjob runs (file-sync, kanban folder-sync, ...)
KNOV_CRONJOB_INTERVAL=5m
# how often the search index is rebuilt
KNOV_SEARCH_INDEX_INTERVAL=15m
# how often metadata is rebuilt from disk
KNOV_METADATA_REBUILD_INTERVAL=60m

# ── editor ────────────────────────────────────────────────────────────────
# default editor for new and unassigned markdown files (empty = use user setting)
# options: codemirror-editor
KNOV_DEFAULT_EDITOR=

# ── notifications ─────────────────────────────────────────────────────────
# how long toast notifications stay visible, in milliseconds
KNOV_NOTIFY_DURATION=3500

# ── kanban ────────────────────────────────────────────────────────────────
# set to false to disable kanban event logging entirely (no storage is created)
# options: true, false
KNOV_KANBAN_EVENTS_ENABLED=true
# prefix used for kanban tags (e.g. "kb" → tag: kb-status-inbox)
KNOV_KANBAN_PREFIX=kb
# all possible kanban statuses (comma-separated, defines all valid tag values)
KNOV_KANBAN_STATUS=inbox,inprogress,blocked,archive
# visible columns on the board (subset of KNOV_KANBAN_STATUS)
KNOV_KANBAN_COLUMNS=inbox,inprogress,blocked
# tags automatically added to newly created files (comma-separated, empty = disabled).
# a bare tag (no ":") applies to every new file everywhere; a "folder/path:tag" entry only
# applies to files created under that folder (recursive - also covers subfolders)
# e.g. starred, projects/work:kb-status-inbox, personal/todo:kb-status-inbox
KNOV_AUTOCREATE_TAGS=
# custom css colors for specific tags on the kanban board (tag:csscolor, comma-separated)
# e.g. username:green,urgent:red,blocked:orange
KNOV_KANBAN_TAG_COLORS=
# card style per kanban status (status:style, comma-separated); styles: normal, italic, highlighted, deleted
# e.g. blocked:italic,waiting:italic,urgent:highlighted,done:deleted,archive:deleted
KNOV_KANBAN_CARD_STYLES=
# status used for the archive drop zone shown while dragging (empty = disable the archive zone)
KNOV_KANBAN_ARCHIVE_STATUS=archive
# statuses a descendant card must have for its ancestor to appear in the ancestor filter
# (comma-separated, subset of KNOV_KANBAN_STATUS; empty = no restriction, all ancestors shown)
# e.g. inbox,inprogress,blocked
KNOV_KANBAN_ANCESTOR_ALLOWED_STATUS=
# kanban boards (folder/path:Display Name, comma-separated); each board covers that folder and
# its subfolders. The URL slug is derived from the folder path automatically.
# e.g. projects/work:Work Board,personal/todo:Personal Todo
KNOV_KANBAN_BOARDS=
# board folder paths (comma-separated, subset of KNOV_KANBAN_BOARDS) that enable foldersync:
# moving a card physically moves the file into folder/path/<status>/, and moving the file on disk
# into an existing folder/path/<status>/ folder sets the tag (picked up by the file-sync cronjob).
# if you move files by hand outside the app, trigger a manual file-sync run before dragging cards
# for those files in the UI - the board doesn't know about an external move until the cronjob has
# run, so a drag against a file that was already moved on disk will fail against its stale path.
# e.g. projects/work
KNOV_KANBAN_FOLDERSYNC=

# ── backup ────────────────────────────────────────────────────────────────
# automatic backup profiles (semicolon-separated; name:cron:storages per profile, on top of manually
# triggered backups on /system/backup); cron is a standard 5-field expression (minute hour
# day-of-month month day-of-week, e.g. "0 18 * * *" for daily at 18:00); storages is comma-separated
# and may be empty for the default backup set. Empty = automatic backups disabled entirely. Each
# profile is due-tracked off its own newest backup's timestamp, not a "ran today" flag, so a device
# that isn't running 24/7 (e.g. a USB stick) still catches up reliably: it backs up as soon as it's
# next on past a missed occurrence, instead of a slot that only ever lands outside its usage window
# getting skipped entirely
# e.g. daily:0 0 * * *:metadata,chat,kanban,notifications,config;weekly-docs:0 0 * * 0:docs,media
KNOV_BACKUP_AUTO_PROFILES=
# how many days of backup sets (default or partial) to always keep, regardless of count
KNOV_BACKUP_ROTATION_KEEP_DAYS=7
# on top of that, the minimum number of default backups to always keep regardless of age - a floor
# so coming back after months away still leaves something restorable. A backup set can also be
# locked individually on /system/backup to always be kept, ignoring both settings above, until unlocked
KNOV_BACKUP_ROTATION_KEEP_DEFAULT=10
