# generated by `make env-example` (see tools/genenv) from internal/configmanager/envdefs.go
# for a more readable overview go to /system/environment
# do not edit by hand - your changes will be overwritten

# ── paths ─────────────────────────────────────────────────────────────────
# path to the markdown data folder (relative to the executable)
KNOV_DATA_PATH=data
# path to the themes folder (relative to the executable)
KNOV_THEMES_PATH=themes
# path to the app's internal storage (metadata/cache/search/kanban databases; relative to the
# executable)
KNOV_STORAGE_PATH=storage
# path to the log files (relative to the executable)
KNOV_LOGS_PATH=logs
# path backup sets are written to and restored from (relative to the executable)
KNOV_BACKUPS_PATH=backups

# ── server ────────────────────────────────────────────────────────────────
# port the app listens on
KNOV_SERVER_PORT=1324
# interface the app listens on; empty = all interfaces, use 127.0.0.1 to only allow local access
KNOV_SERVER_HOST=
# message shown in a banner at the top of every page (e.g. to label a test/copy environment);
# empty = hidden
KNOV_MOTD=

# ── logging ───────────────────────────────────────────────────────────────
# stdout log level
# options: debug, info, warning, error
KNOV_LOG_LEVEL=info
# file logging (writes to logs/app.log with rotation)
# options: true, false
KNOV_LOG_FILE_ENABLED=true
# file log level
# options: debug, info, warning, error
KNOV_LOG_FILE_LEVEL=info
# max size in MB before rotating
KNOV_LOG_MAX_SIZE_MB=10
# number of rotated files to keep
KNOV_LOG_MAX_FILES=5

# ── git ───────────────────────────────────────────────────────────────────
# remote sync URL (leave empty for local-only mode); if set and no local repo exists yet, knov
# will clone it on first start
KNOV_GIT_REMOTE=
# remote branch to sync with
KNOV_GIT_REMOTE_BRANCH=main
# automatically push after every commit
# options: true, false
KNOV_GIT_AUTO_PUSH=true
# timeout for push/pull operations
KNOV_GIT_PUSH_TIMEOUT=10s
# HTTPS username (leave empty for SSH or local repo)
KNOV_GIT_USER=
# HTTPS password (leave empty for SSH or local repo)
KNOV_GIT_PASSWORD=
# HTTPS access token, takes priority over KNOV_GIT_PASSWORD (leave empty for SSH or local repo)
KNOV_GIT_TOKEN=
# SSH private key path (leave empty to use ssh-agent or ~/.ssh/id_rsa, id_ed25519, id_ecdsa); set
# this if you use a non-default key file, e.g. ~/.ssh/id_rsa_privat
KNOV_GIT_SSH_KEY=

# ── storage providers ─────────────────────────────────────────────────────
# app settings storage
# options: json
KNOV_CONFIG_STORAGE_PROVIDER=json
# metadata storage
# options: json, yaml, sqlite
KNOV_METADATA_STORAGE_PROVIDER=sqlite
# cache storage
# options: json, sqlite
KNOV_CACHE_STORAGE_PROVIDER=sqlite
# search index storage
# options: sqlite
KNOV_SEARCH_STORAGE_PROVIDER=sqlite
# tracker counter day-delta storage
# options: sqlite
KNOV_TRACKER_STORAGE_PROVIDER=sqlite
# kanban event log storage
# options: json, sqlite
KNOV_KANBAN_EVENTS_STORAGE_PROVIDER=sqlite

# ── search ────────────────────────────────────────────────────────────────
# search engine
# options: repository, grep
KNOV_SEARCH_ENGINE=repository

# ── cronjob ───────────────────────────────────────────────────────────────
# how often the background cronjob runs (file-sync, kanban folder-sync, ...)
KNOV_CRONJOB_INTERVAL=5m
# how often the search index is rebuilt
KNOV_SEARCH_INDEX_INTERVAL=15m
# how often metadata is rebuilt from disk
KNOV_METADATA_REBUILD_INTERVAL=60m

# ── editor ────────────────────────────────────────────────────────────────
# default editor for new and unassigned markdown files (empty = use user setting)
# options: codemirror-editor
KNOV_DEFAULT_EDITOR=

# ── notifications ─────────────────────────────────────────────────────────
# how long toast notifications stay visible, in milliseconds
KNOV_NOTIFY_DURATION=3500
# minimum severity that still shows a toast (lower levels are still written to the notification
# log)
# options: info, warning, error, off
KNOV_NOTIFY_MIN_LEVEL=info

# ── kanban ────────────────────────────────────────────────────────────────
# set to false to disable kanban event logging entirely (no storage is created)
# options: true, false
KNOV_KANBAN_EVENTS_ENABLED=true
# prefix used for kanban tags (e.g. "kb" → tag: kb-status-inbox), letters, digits and _ only;
# existing tags are not renamed, so after a change cards still tagged with the old prefix drop off
# the board until they're retagged
KNOV_KANBAN_PREFIX=kb

# ── tracker ───────────────────────────────────────────────────────────────
# Trackers are named counters (e.g. habit or hit-count tracking) with +/- buttons and a generated
# markdown stats table. Turning off KNOV_TRACKER_ENABLED hides the tracker editor and switches its
# day-delta storage to a noop backend - any existing tracker.db is left on disk untouched but
# reads as empty, so every tracker's stats markdown regenerates to all-zero (not deleted, just
# invisible) until it's turned back on.
#
# set to false to disable the tracker editor entirely (no storage is created)
# options: true, false
KNOV_TRACKER_ENABLED=true

# ── backup ────────────────────────────────────────────────────────────────
# Backups snapshot metadata, chat, kanban, notifications, config and search by default. Docs and
# media are optional - select them individually since they're already tracked by git, and
# including them can make a backup much larger. Each storage is backed up one at a time, not as a
# single point-in-time transaction. Backups can also run automatically on a schedule
# (KNOV_BACKUP_AUTO_PROFILES), on top of the manual backups triggered on /system/backup. Each
# profile is due-tracked off its own newest backup's timestamp rather than a "ran today" flag, so
# a device that isn't running 24/7 (e.g. a USB stick) still catches up reliably instead of missing
# a scheduled slot entirely.
#
# Rotation is tuned via KNOV_BACKUP_ROTATION_KEEP_DAYS (days of backups always kept) and
# KNOV_BACKUP_ROTATION_KEEP_DEFAULT (minimum number of default backups always kept, regardless of
# age). See .env.example for details.
#
# automatic backup profiles: semicolon-separated
# "<name>:<cron>:<storages>,<name>:<cron>:<storages>" and comma separated for multiple entries.
# name is freely chooseable; cron is a standard 5-field expression; storages is comma-separated
# and may be empty for the default backup set. Empty = automatic backups disabled entirely.
#
# Examples:
#     daily:0 0 * * *:                                     nightly backup of the default storage set
#     weekly-docs:0 0 * * 0:docs,media                     weekly backup of docs and media, every Sunday at midnight
#     daily:0 0 * * *:;weekly-docs:0 0 * * 0:docs,media    both combined into one profile list
KNOV_BACKUP_AUTO_PROFILES=
# how many days of backup sets (default or partial) to always keep, regardless of count
KNOV_BACKUP_ROTATION_KEEP_DAYS=7
# on top of that, the minimum number of default backups to always keep regardless of age - a floor
# so coming back after months away still leaves something restorable. A backup set can also be
# locked individually on /system/backup to always be kept, ignoring both settings above, until
# unlocked
KNOV_BACKUP_ROTATION_KEEP_DEFAULT=10
# S3 bucket backup sets are written to and restored from. Non-empty switches backup storage from
# the local filesystem (KNOV_BACKUPS_PATH) to S3 (or any S3-compatible service: MinIO, Cloudflare
# R2, Backblaze B2, DigitalOcean Spaces). Leave empty for local-filesystem backups
KNOV_BACKUP_S3_BUCKET=
# S3 endpoint host, no scheme (e.g. s3.amazonaws.com, nyc3.digitaloceanspaces.com,
# localhost:9000). Required when KNOV_BACKUP_S3_BUCKET is set
KNOV_BACKUP_S3_ENDPOINT=
# S3 region for backup storage (e.g. us-east-1); may be left empty for providers that don't need
# it
KNOV_BACKUP_S3_REGION=
# key prefix applied to every backup object in the bucket (e.g. knov/backups/); empty = bucket
# root
KNOV_BACKUP_S3_PREFIX=
# S3 access key id
KNOV_BACKUP_S3_ACCESS_KEY=
# S3 secret access key
KNOV_BACKUP_S3_SECRET_KEY=
# connect to the S3 endpoint over HTTPS
# options: true, false
KNOV_BACKUP_S3_USE_SSL=true
